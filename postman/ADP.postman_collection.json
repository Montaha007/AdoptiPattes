{
  "info": {
    "name": "ADP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order against a demo instance. Destructive test records are created and removed."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "memberToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "annonceId",
      "value": ""
    },
    {
      "key": "commentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Public announcements",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/annonces"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Filter by city and type",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/annonces?type=ADOPTION&ville=Tunis"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Visitor cannot publish",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/annonces",
        "body": {
          "mode": "raw",
          "raw": "{\"titre\": \"Postman kitten\", \"type\": \"ADOPTION\", \"espece\": \"CHAT\", \"description\": \"A friendly test kitten\", \"ville\": \"Tunis\", \"statut\": \"OUVERTE\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Visitor cannot delete",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/annonces/1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Visitor cannot view users",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login member",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"maya@adoptipattes.local\", \"password\": \"MemberDemo!2026\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('memberToken', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"admin@adoptipattes.local\", \"password\": \"AdminDemo!2026\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('adminToken', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Member publishes (author spoof ignored)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{memberToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/annonces",
        "body": {
          "mode": "raw",
          "raw": "{\"titre\": \"Postman kitten\", \"type\": \"ADOPTION\", \"espece\": \"CHAT\", \"description\": \"A friendly test kitten\", \"ville\": \"Tunis\", \"statut\": \"OUVERTE\", \"idUser\": 1}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('annonceId',pm.response.json().id);",
              "pm.test('Author is Maya',()=>pm.expect(pm.response.json().auteur.prenom).to.eql('Maya'));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Detail",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/annonces/{{annonceId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Add comment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{memberToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/annonces/{{annonceId}}/commentaires",
        "body": {
          "mode": "raw",
          "raw": "{\"contenu\": \"I can help\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('commentId',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Public comments",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/annonces/{{annonceId}}/commentaires"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Member cannot edit",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{memberToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/annonces/{{annonceId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"titre\": \"Postman kitten\", \"type\": \"ADOPTION\", \"espece\": \"CHAT\", \"description\": \"A friendly test kitten\", \"ville\": \"Tunis\", \"statut\": \"OUVERTE\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 403', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Member cannot delete",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{memberToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/annonces/{{annonceId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 403', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Member cannot view users",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{memberToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 403', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 Admin changes status",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/annonces/{{annonceId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"titre\": \"Postman kitten\", \"type\": \"ADOPTION\", \"espece\": \"CHAT\", \"description\": \"A friendly test kitten\", \"ville\": \"Tunis\", \"statut\": \"EN_COURS\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "16 Admin updates comment",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/commentaires/{{commentId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"contenu\": \"Updated by admin\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "17 Admin lists users",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('No passwords',()=>pm.response.json().forEach(u=>pm.expect(u).not.to.have.property('password')));"
            ]
          }
        }
      ]
    },
    {
      "name": "18 Admin deletes comment",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/commentaires/{{commentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "19 Admin deletes announcement",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/annonces/{{annonceId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "20 Deleted announcement returns 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/annonces/{{annonceId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "21 Stray requires GPS",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{memberToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/annonces",
        "body": {
          "mode": "raw",
          "raw": "{\"titre\": \"Postman kitten\", \"type\": \"ANIMAL_ERRANT\", \"espece\": \"CHAT\", \"description\": \"A friendly test kitten\", \"ville\": \"Tunis\", \"statut\": \"OUVERTE\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "22 Registration (check SMTP inbox in normal profile)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"member-{{$timestamp}}@example.com\", \"password\": \"PostmanPass!2026\", \"prenom\": \"Postman\", \"nom\": \"Member\", \"tel\": \"+21620000000\", \"roles\": [\"ADMIN\"]}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('Registration cannot grant admin',()=>pm.expect(pm.response.json().user.roles).to.eql(['MEMBRE']));"
            ]
          }
        }
      ]
    },
    {
      "name": "23 Invalid login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"maya@adoptipattes.local\", \"password\": \"wrong\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
}