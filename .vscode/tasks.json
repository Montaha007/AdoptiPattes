{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start MySQL app",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/start-mysql.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Angular development server",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "start"
      ],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "Build complete application",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/build.ps1"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Spring Boot development (MySQL)",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/start-mysql.ps1",
        "-Development"
      ],
      "problemMatcher": []
    }
  ]
}
